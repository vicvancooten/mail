{
  "name": "@mail/sync-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "mail": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && rm -rf dist/db/migrations && mkdir -p dist/db/migrations && cp -r src/db/migrations/. dist/db/migrations/",
    "start": "node dist/main.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@mail/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.0",
    "@simplewebauthn/server": "^13.3.3",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "imapflow": "^1.7.6",
    "nodemailer": "^9.0.6",
    "otplib": "^13.5.0",
    "postgres": "^3.4.9",
    "sanitize-html": "^2.17.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "nid-webauthn-emulator": "^0.2.15",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
