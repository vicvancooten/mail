{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Matches `resolve.alias` in vite.config.ts. No `baseUrl`: TS 6
       deprecates it, and `paths` resolves relative to this file without it. */
    "paths": { "@/*": ["./src/*"] },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // `sw.ts` runs in the ServiceWorker global scope, not DOM — its own
  // `tsconfig.sw.json` (WebWorker lib) typechecks it instead, since the two
  // libs declare `self` and friends incompatibly. `device-theme.test.ts`
  // reads files off disk with `node:fs`/`node:path`/`node:url`, which this
  // browser-scoped config has no Node types for — its own
  // `tsconfig.test-node.json` (this config plus `types: ["node"]`)
  // typechecks it instead.
  "exclude": ["src/sw.ts", "src/sw-env.d.ts", "src/theme/device-theme.test.ts"]
}
