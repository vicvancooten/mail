{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test-node.tsbuildinfo",
    // Same DOM lib as tsconfig.app.json (the test drives `document`,
    // `localStorage`, …) plus `node` for the `node:fs`/`node:path`/`node:url`
    // reads that assert the built manifest/HTML against source-of-truth
    // constants — see device-theme.test.ts's own comment for why.
    "types": ["vite/client", "node"]
  },
  "include": ["src/theme/device-theme.test.ts"],
  // Override the inherited exclude — it drops this exact file to keep it
  // out of tsconfig.app.json, which would otherwise shadow the `include`.
  "exclude": []
}
