# Copy to .env and fill in. compose.dev.yaml reads this file; the app
# refuses to boot without PUBLIC_URL and MAIL_CREDENTIAL_KEY (ADR-0009).

# Origin the app is reached at. Source of truth for the WebAuthn RP ID,
# cookie scope, and Web Push — changing it later re-enrolls every passkey.
PUBLIC_URL=http://localhost:3000

# `openssl rand -base64 32`. Losing it costs re-authenticating every Mail
# Account, not mail loss (ADR-0003 / ADR-0009).
MAIL_CREDENTIAL_KEY=dev-only-not-a-real-key-replace-me-32b

# host:port the app binds. Loopback by default; compose.dev.yaml overrides
# this to 0.0.0.0 so the host can reach the container.
MAIL_BIND=127.0.0.1:3000

# Postgres, matching compose.dev.yaml's `postgres` service.
DATABASE_URL=postgres://mail:mail@localhost:5432/mail
POSTGRES_USER=mail
POSTGRES_PASSWORD=mail
POSTGRES_DB=mail

# GreenMail dev IMAP/SMTP test server (compose.dev.yaml). Default GreenMail
# credentials: any user@localhost / password logs in (dynamic accounts).
IMAP_TEST_HOST=localhost
IMAP_TEST_PORT=3143
SMTP_TEST_PORT=3025
