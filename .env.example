# Copy to .env and fill in. compose.dev.yaml reads this file; the app
# refuses to boot without PUBLIC_URL and MAIL_CREDENTIAL_KEY (ADR-0009).

# Origin the app is reached at. Source of truth for the WebAuthn RP ID,
# cookie scope, and Web Push — changing it later re-enrolls every passkey.
PUBLIC_URL=http://localhost:3000

# `openssl rand -base64 32`. Losing it costs re-authenticating every Mail
# Account, not mail loss (ADR-0003 / ADR-0009).
MAIL_CREDENTIAL_KEY=dev-only-not-a-real-key-replace-me-32b

# host:port the app binds. Loopback by default; compose.dev.yaml overrides
# this to 0.0.0.0 so the host can reach the container.
MAIL_BIND=127.0.0.1:3000

# Which GHCR image tag the production compose.yaml pulls. Defaults to the
# latest main build; pin to an immutable `sha-<short>` (or a `vX.Y.Z`
# release tag) to roll back — see README.md#rolling-back.
# MAIL_VERSION=edge

# Postgres, matching compose.dev.yaml's `postgres` service.
DATABASE_URL=postgres://mail:mail@localhost:5432/mail
POSTGRES_USER=mail
POSTGRES_PASSWORD=mail
POSTGRES_DB=mail

# Host port compose.dev.yaml publishes Postgres on. Change this if 5432 is
# already taken on your machine — DATABASE_URL is a plain connection string,
# not composed from the vars above, so its port must be updated to match by
# hand.
POSTGRES_PORT=5432

# GreenMail dev IMAP/SMTP test server (compose.dev.yaml). Default GreenMail
# credentials: any user@localhost / password logs in (dynamic accounts).
IMAP_TEST_HOST=localhost
IMAP_TEST_PORT=3143
SMTP_TEST_PORT=3025

# ADR-0012's instance-level attachment budget, in encoded (base64) bytes.
# Optional — defaults to 25MB (~18MB of real files).
# ATTACHMENT_BUDGET_BYTES=26214400

# Web Push (ADR-0015). Optional — unset means no push notifications and the
# "Enable on this device" control stays hidden; everything else works. The
# two keys must be set together. Generate once and keep: regenerating
# invalidates every browser's existing push subscription.
#   local:  pnpm --filter @mail/sync-backend cli generate-vapid-keys
#   docker: docker compose run --rm app mail generate-vapid-keys
# MAIL_VAPID_PUBLIC_KEY=
# MAIL_VAPID_PRIVATE_KEY=
# Contact URI RFC 8292 requires alongside the keypair (a push service's abuse
# contact). Set a real mailto: if you enable Web Push.
# MAIL_VAPID_CONTACT=mailto:admin@localhost
